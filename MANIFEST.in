include LICENSE NOTICE README.md
include Dockerfile .dockerignore glama.json
recursive-include third_party/runtime-llama *.whl LICENSE NOTICE *.LICENSE provenance.json
recursive-include docs *.md
recursive-include docs/presentation *.html *.json *.css *.js *.png *.txt *.py
recursive-include tools *.py *.sh *.ps1
include assets/flower-mcp-logo.png
prune tests
prune qualification
prune config
prune runtime
prune data
prune logs
prune authorities
prune work
global-exclude *.py[cod] .DS_Store
